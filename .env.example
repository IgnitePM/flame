VITE_FIREBASE_API_KEY=YOUR_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=YOUR_AUTH_DOMAIN
VITE_FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
VITE_FIREBASE_STORAGE_BUCKET=YOUR_STORAGE_BUCKET
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_MESSAGING_SENDER_ID
VITE_FIREBASE_APP_ID=YOUR_APP_ID

# --- Netlify Functions (server-side only — set these in the Netlify UI under
# Project configuration > Environment variables. They are NOT read by Vite/the
# client bundle, so they don't need the VITE_ prefix and won't be exposed to
# the browser.) ---

# Used by netlify/functions/gemini-summarize.js and gemini-extract-todos.js
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# Used by netlify/functions/lib/firebaseDigestClient.mjs (daily/weekly digest
# Firestore reads). Signs in as a dedicated Firebase Auth account instead of
# using a service account key — works even when your org disables service
# account key creation (iam.disableServiceAccountKeyCreation).
#
# Setup: Firebase Console > Authentication > enable Email/Password sign-in,
# then Users > Add user to create this account. Then Firestore Database >
# admins collection > Add document, with the document ID equal to this email
# (lowercased) and fields { email: "<same email>", role: "billing" } so
# firestore.rules treats it as staff.
#
# IMPORTANT: the VITE_FIREBASE_* variables above must also be scoped to
# "Functions" in Netlify (not just Builds) since this reuses the same
# Firebase project config to sign in.
DIGEST_BOT_EMAIL=digest-bot@yourdomain.com
DIGEST_BOT_PASSWORD=YOUR_STRONG_PASSWORD

# Used by netlify/functions/lib/mailer.mjs (Gmail SMTP sender for the digests).
# GMAIL_APP_PASSWORD requires 2-Step Verification on the Gmail account —
# generate one at https://myaccount.google.com/apppasswords
GMAIL_USER=updates@yourdomain.com
GMAIL_APP_PASSWORD=YOUR_16_CHAR_APP_PASSWORD
GMAIL_FROM_NAME=Ignite PM Workspace

# Optional fallback recipient list (comma-separated). If empty (and the admin
# Config card list is empty), personal digests email every staff member in
# the Firestore admins collection (except DIGEST_BOT_EMAIL).
DIGEST_RECIPIENTS=

